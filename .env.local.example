# Copy to .env.local and fill in real values. Never commit .env.local.
# Run locally with: npx vercel dev
# On Vercel, set the same variables in Project Settings > Environment Variables.

SMTP_HOST=smtp.email.ap-singapore-1.oci.oraclecloud.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Must be an approved sender in Oracle Email Delivery
MAIL_FROM=noreply@example.com

# Where form submissions are sent (comma-separated for several)
MAIL_TO=recipient@example.com
